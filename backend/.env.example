# --- Server ---
HOST=0.0.0.0
PORT=8000
# Comma-separated origins the frontend is served from.
CORS_ORIGINS=http://localhost:3000

# --- Deployment identity ---
# Stamped onto every PostHog event, log record and captured exception, so a
# development machine's telemetry is separable from production's and a
# regression can be attributed to a deploy rather than to a date.
# Set ENVIRONMENT=production on the server: a production deployment with no
# PostHog key configured is reported at startup only when this says so.
ENVIRONMENT=development
# Usually left blank. `scripts/deploy-vps.sh` writes the deployed commit to a
# `.release-sha` marker beside the tree, which the app reads when this is unset;
# set it explicitly only where that file cannot exist.
RELEASE=

# --- Database ---
# Local/dev default is sqlite; point at Postgres in production, e.g.
# postgresql+asyncpg://devrimo:devrimo@localhost:5432/devrimo
# Agno stores conversation history in this same database (agno_* tables) using
# a synchronous driver it derives from this URL — Postgres deployments need
# psycopg installed alongside asyncpg, which requirements.txt handles.
DATABASE_URL=sqlite+aiosqlite:///./devrimo.db

# --- Auth (Supabase) ---
# Project ref, e.g. https://abcxyz.supabase.co
SUPABASE_URL=https://your-project.supabase.co
# Only needed if the project still issues legacy HS256 JWTs.
# Leave unset for projects using the asymmetric (ES256/RS256) signing keys,
# which are verified via SUPABASE_URL's JWKS endpoint instead.
SUPABASE_JWT_SECRET=
SUPABASE_SECRET_KEY=
ADMIN_BOOTSTRAP_USER_IDS=
ADMIN_DIRECTORY_SYNC_SECONDS=300
POSTHOG_DASHBOARD_URL=

# --- Agent runtime ---
# "agno" builds a real Agno agent and launches real campus MCP subprocesses.
# "fake" swaps in an echo model so the whole API can be exercised without a
# model provider or the four servers installed — everything else stays real.
AGENT_RUNTIME=agno
# The hardened ODTÜ student profile. Set legacy only as an emergency rollback.
AGENT_PROFILE=scholar
# How many prior runs of a session are replayed into the model's context.
AGENT_HISTORY_RUNS=10
# Scholar keeps a short verbatim window and compresses older tool results.
SCHOLAR_HISTORY_RUNS=3
AGENT_TOOL_CALL_LIMIT=10
AGENT_COMPRESS_TOOL_RESULTS=true
AGENT_COMPRESS_TOOL_RESULTS_LIMIT=3
# Only explicit, non-sensitive preferences may become user memories.
AGENT_LEARNING_ENABLED=true
AGENT_RETRIES=2
# Event storage is off by default to reduce retained student content.
AGENT_STORE_EVENTS=false
# Writes redacted spans and run metrics to the shared Agno database.
AGENT_TRACING_ENABLED=true
# A student's agent (and its MCP subprocesses) is torn down after this long
# idle. Nothing is lost: history lives in the database, so the next turn
# rebuilds transparently.
AGENT_IDLE_TIMEOUT_SECONDS=900
# Ceiling on simultaneously-resident students. Each resident agent holds one
# subprocess per connected campus server, so this and the broker's memory and
# PID limits should be sized together.
AGENT_POOL_MAX_SIZE=64
RECONCILE_INTERVAL_SECONDS=60
# The broker renews this owner-scoped lease while a stream is active.
TURN_LOCK_LEASE_SECONDS=180
TURN_LOCK_HEARTBEAT_SECONDS=60

# --- Model provider ---
# OpenCode Go (e.g. MuseSpark 1.2 Contributor):
# AGENT_MODEL=muse-spark-1.2-contributor
# AGENT_OPENAI_BASE_URL=https://opencode.ai/zen/go/v1
# AGENT_OPENAI_API_KEY=sk-...
#
# Or OpenRouter:
AGENT_MODEL=muse-spark-1.2-contributor
AGENT_OPENAI_BASE_URL=https://opencode.ai/zen/go/v1
AGENT_OPENAI_API_KEY=
AGENT_MAX_TOKENS=32768

# --- Telemetry ---
# The Agent is constructed with telemetry=False in code; this is the second
# belt. Without it Agno posts run telemetry to os-api.agno.com.
AGNO_TELEMETRY=false

# --- Observability (PostHog) ---
# Optional. With POSTHOG_API_KEY unset the whole integration is a no-op and the
# broker runs unchanged — but set POSTHOG_DEBUG=true in development so that
# absence is announced at startup instead of looking like healthy silence.
# EU cloud. Use https://us.i.posthog.com on US cloud; the OTLP log endpoint
# derives from this, so getting it wrong drops logs silently.
POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_API_KEY=
# Personal API key (phx_...). Only enables *local* feature-flag evaluation,
# which keeps flag lookups off the network on the chat hot path. Without it
# flags still work, just with a request per lookup.
POSTHOG_PERSONAL_API_KEY=
# Master kill switch, independent of whether a key is present.
POSTHOG_ENABLED=true
# AI observability deliberately captures complete prompts, completions, tool
# inputs, and tool outputs. Credential-shaped keys and values are still
# redacted before upload.
POSTHOG_DEBUG=false
# The model is served from an OpenAI-compatible endpoint PostHog has no price
# table for, so cost is reported from these. Per single token, not per million:
# $3.00 per 1M input tokens is 0.000003. Left at 0, cost reporting is blank.
POSTHOG_INPUT_TOKEN_PRICE=0
POSTHOG_OUTPUT_TOKEN_PRICE=0

# --- AgentOS (dedicated internal service) ---
# The compose service binds to 127.0.0.1:7777. In production put it behind a
# TLS reverse proxy/VPN; never publish it directly. Tokens must have aud=devrimo.
AGENTOS_ENABLED=false
AGENTOS_JWT_ALGORITHM=RS256
# PEM public key used to verify your operations identity provider's JWTs.
# Keep private signing keys outside this repository and outside AgentOS.
AGENTOS_JWT_VERIFICATION_KEY=
# Alternatively mount a JWKS JSON file into the AgentOS container.
AGENTOS_JWKS_FILE=
AGENTOS_JWT_AUDIENCE=devrimo
AGENTOS_ADMIN_SCOPE=agentos:admin
AGENTOS_CORS_ORIGINS=https://os.agno.com

# --- Campus MCP servers ---
# Where the four per-server virtualenvs are installed. The Dockerfile builds
# them here; a bare-metal dev setup has to create them at the same paths (see
# the Dockerfile's stage 1) or the servers simply never start.
CAMPUS_MCP_ROOT=/opt/mcp
# Per-student working directories. Servers that cache a campus session token
# relative to their CWD get a private 0700 directory beneath this, so it must
# be writable by the broker's user and should survive restarts.
#
# This default is a path the image creates. Running the broker outside the
# container has no write access to /var/lib, so set a local path there —
# CAMPUS_STATE_ROOT=./.campus-state — or every server that needs a cache is
# skipped with a "campus_state_dir_unavailable" warning. Skipped, not fatal:
# the agent still starts with its remaining tools.
CAMPUS_STATE_ROOT=/var/lib/devrimo/campus
CAMPUS_MCP_TIMEOUT_SECONDS=30
# Read the student's academic context from SAIS while saving a verified
# campus connection, so their profile is filled in before the first turn.
# Costs one campus server spawn inside that request; set false to keep the
# save fast and leave the context to the planner's in-turn refresh.
CAMPUS_CONTEXT_SYNC_ON_CONNECT=true
# Which server is pinned to which ref is a build arg, not a runtime setting —
# see the Dockerfile. Per-student credentials are collected through onboarding
# and stored encrypted; nothing about them belongs in this file.

# --- Campus knowledge layer ---
# The dedicated knowledge-worker service discovers due sources and processes
# durable ingestion jobs. Source URLs, adapters, schedules, and filters are
# administered through the UI and versioned in the database.
KNOWLEDGE_WORKER_POLL_SECONDS=15
KNOWLEDGE_FETCH_TIMEOUT_SECONDS=20
KNOWLEDGE_FETCH_MAX_BYTES=10000000
KNOWLEDGE_FETCH_USER_AGENT=DevrimoCampusKnowledge/1.0
# Semantic ranking is optional: PostgreSQL full-text search remains available
# without it. These values are deployment fallbacks only; a campus admin can
# override them per organization with a local OpenAI-compatible endpoint or a
# remote provider from the Campus knowledge dashboard. Remote keys entered in
# the dashboard are encrypted. Only canonical public records may be embedded.
KNOWLEDGE_EMBEDDING_ENABLED=false
KNOWLEDGE_EMBEDDING_MODEL=text-embedding-3-small
KNOWLEDGE_EMBEDDING_DIMENSIONS=1536
KNOWLEDGE_EMBEDDING_BASE_URL=https://api.openai.com/v1
KNOWLEDGE_EMBEDDING_API_KEY=

# --- Secrets ---
# Encrypts students' METU passwords at rest (Fernet, see app/core/crypto.py).
# Rotating this key without re-encrypting makes every stored campus connection
# undecryptable, and every student has to reconnect their METU account.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_ENCRYPTION_KEY=change-me-to-a-real-generated-secret

# --- Compose networking ---
# The internal bridge is named per Compose project by default, so several
# stacks (for example one per git worktree) can run on one host without their
# `postgres` service aliases colliding. Set this only to pin a fixed bridge
# name for a host firewall rule, and only where a single stack owns the host.
# DEVRIMO_NETWORK_NAME=devrimo-internal
