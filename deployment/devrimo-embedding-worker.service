[Unit]
Description=Devrimo embedding worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=devrimo-embedding
WorkingDirectory=/opt/devrimo/backend
EnvironmentFile=/etc/devrimo/embedding.env
Environment=DEVRIMO_ENV_FILE=
Environment=DATABASE_RUNTIME_ROLE=embedding
Environment=DEVRIMO_RUNTIME_COMPONENT=embedding
ExecStart=/opt/devrimo/backend/.venv/bin/python -m app.knowledge.embedding_worker
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=devrimo-workers/embedding
StateDirectoryMode=0700
ReadWritePaths=/var/lib/devrimo/campus

[Install]
WantedBy=multi-user.target
