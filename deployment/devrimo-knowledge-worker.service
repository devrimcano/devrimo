[Unit]
Description=Devrimo knowledge worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=devrimo-knowledge
WorkingDirectory=/opt/devrimo/backend
EnvironmentFile=/etc/devrimo/knowledge.env
Environment=DEVRIMO_ENV_FILE=
Environment=DATABASE_RUNTIME_ROLE=knowledge
Environment=DEVRIMO_RUNTIME_COMPONENT=knowledge
ExecStart=/opt/devrimo/backend/.venv/bin/python -m app.knowledge.worker
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=devrimo-workers/knowledge
StateDirectoryMode=0700
ReadWritePaths=/var/lib/devrimo/campus

[Install]
WantedBy=multi-user.target
