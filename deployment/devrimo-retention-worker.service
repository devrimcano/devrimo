[Unit]
Description=Devrimo retention worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=devrimo-retention
WorkingDirectory=/opt/devrimo/backend
EnvironmentFile=/etc/devrimo/retention.env
Environment=DEVRIMO_ENV_FILE=
Environment=DATABASE_RUNTIME_ROLE=catalog
Environment=DEVRIMO_RUNTIME_COMPONENT=retention
ExecStart=/opt/devrimo/backend/.venv/bin/python -m app.workers.runtime retention
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=devrimo-workers/retention
StateDirectoryMode=0700
ReadWritePaths=/var/lib/devrimo/campus

[Install]
WantedBy=multi-user.target
