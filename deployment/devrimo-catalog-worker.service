[Unit]
Description=Devrimo catalog worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=devrimo-catalog
WorkingDirectory=/opt/devrimo/backend
EnvironmentFile=/etc/devrimo/catalog.env
Environment=DEVRIMO_ENV_FILE=
Environment=DATABASE_RUNTIME_ROLE=catalog
Environment=DEVRIMO_RUNTIME_COMPONENT=catalog
Environment=CAMPUS_STATE_ROOT=/var/lib/devrimo/campus-catalog
ExecStart=/opt/devrimo/backend/.venv/bin/python -m app.workers.runtime catalog
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=devrimo-workers/catalog
StateDirectoryMode=0700
ReadWritePaths=/var/lib/devrimo/campus-catalog

[Install]
WantedBy=multi-user.target
