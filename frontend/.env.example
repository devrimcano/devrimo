# --- Supabase (auth) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Either name works; PUBLISHABLE_KEY is the newer one.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public browser URL used after email confirmation. Set this to the canonical
# production domain; do not rely on the internal server bind address.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Broker ---
# The FastAPI agent broker. Server-side only: the browser always goes through
# this app's own /api/** route handlers, never straight to the broker.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Observability (PostHog) ---
# Project token (phc_...). With this unset the SDK never initialises and the
# app runs unchanged — but a development build says so loudly in the console,
# because "no events" and "no key" look identical from PostHog's side.
NEXT_PUBLIC_POSTHOG_KEY=
# EU cloud. Must match the region the project was created in.
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Hostnames that get X-POSTHOG-DISTINCT-ID / X-POSTHOG-SESSION-ID attached, so
# the broker can link its LLM traces and errors to this browser's session
# replay. This app's own hostname — the browser only ever calls same-origin.
# Hostnames only: a port makes the value match nothing at all.
# The browser's own hostname is always included regardless of this value, so a
# deployment that forgets to set it still correlates its traces.
NEXT_PUBLIC_POSTHOG_TRACING_HOSTS=localhost,127.0.0.1
# Environment and release labels on every browser and route-handler event, so
# they line up with the broker's. `scripts/deploy-vps.sh` exports
# NEXT_PUBLIC_RELEASE from the deployed commit at build time, and uploads the
# browser source maps under the same value.
NEXT_PUBLIC_ENVIRONMENT=development
NEXT_PUBLIC_RELEASE=

# --- Build-time only: source map upload ---
# A personal API key (phx_...), not the project token. Deliberately not
# NEXT_PUBLIC_: it is a build secret and must never reach the browser. Without
# both of these the build still succeeds, with unresolved production stack
# traces.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
